{
  "name": "todo-electron",
  "version": "1.0.0",
  "description": "A simple daily/project to-do list",
  "main": "main.js",
  "author": "paoi",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.paoi.dailytasks",
    "productName": "questly",
    "files": ["main.js", "preload.js", "index.html", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
